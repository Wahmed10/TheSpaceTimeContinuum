DATABASE_URL=
# Use a disposable Neon development branch for live integration tests.
TEST_DATABASE_URL=
# Explicitly set to development to enable migrations/seeds in the live test.
DB_TEST_ALLOW_WRITES=
PROVIDER_CONTACT=
# Phase 4B scheduled proof only; live providers are introduced later.
INGEST_PROVIDERS=dummy
NEXT_PUBLIC_SENTRY_DSN=
# Optional HTTP(S) origin for canonical/OG URLs (set for the web build).
# Copy to apps/web/.env.local, or set SITE_URL in the build environment.
SITE_URL=
