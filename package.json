{
  "name": "space-time-continuum",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "tsx tools/validate-catalog.ts && pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && tsx tools/check-boundaries.ts",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "playwright test",
    "perf:cpu": "node --import tsx tools/run-cpu-perf.mjs",
    "ingest:due": "tsx packages/ingest/src/runner.ts",
    "fixtures:horizons": "tsx tools/fixtures/fetch-horizons.ts",
    "assets:build": "tsx tools/assets/build-ktx.ts && tsx tools/assets/build-moon.ts && tsx tools/assets/build-mars.ts && tsx tools/assets/build-sky.ts && tsx tools/assets/build-stars.ts && tsx tools/assets/build-new-horizons.ts",
    "assets:preview": "tsx tools/assets/build-textures.ts",
    "licenses:check": "tsx tools/check-licenses.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.1"
  },
  "type": "module"
}
